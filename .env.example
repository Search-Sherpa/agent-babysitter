# Environment variables read by agent-babysitter and its advisor wrappers.
# Every value here is a placeholder. Leave a line unset to use the default.

# --- babysitter itself ---------------------------------------------------------

# Path to the JSON config file (default: ~/.config/agent-babysitter/config.json).
BABYSITTER_CONFIG=
# Directory for approvals, consult receipts and ledgers (default: ~/.local/state/agent-babysitter).
BABYSITTER_STATE_DIR=
# Model family driving this agent session: claude, gemini, codex or grok. Set per session.
BABYSITTER_HOST_FAMILY=
# Path to a POSIX bash for the advisor wrappers (found next to git or on PATH if unset).
BABYSITTER_BASH=

# --- advisor wrappers ----------------------------------------------------------
# `babysitter consult` always sets ASK_<FAMILY>_TIMEOUT from the config, and sets
# ASK_<FAMILY>_MODEL when the config names a model. The rest pass through as set.

# Claude advisor: model id passed to --model (default: the CLI's own default).
ASK_CLAUDE_MODEL=
# Claude advisor: wall-clock timeout in seconds (default 180).
ASK_CLAUDE_TIMEOUT=
# Claude advisor: minimum printable stdout bytes to count as an answer (default 1).
ASK_CLAUDE_MIN_BYTES=

# Gemini advisor: CLI binary to run (default: agy).
ASK_GEMINI_CLI=
# Gemini advisor: model id; required, and must start with gemini-.
ASK_GEMINI_MODEL=
# Gemini advisor: wall-clock timeout in seconds (default 360).
ASK_GEMINI_TIMEOUT=
# Gemini advisor: minimum printable stdout bytes to count as an answer (default 1).
ASK_GEMINI_MIN_BYTES=

# Codex advisor: model id passed to -m (default: the model in the Codex config file).
ASK_CODEX_MODEL=
# Codex advisor: reasoning effort passed as model_reasoning_effort (default: the Codex config file).
ASK_CODEX_EFFORT=
# Codex advisor: wall-clock timeout in seconds (default 600).
ASK_CODEX_TIMEOUT=
# Codex advisor: set to 1 to keep a resumable session instead of an ephemeral run.
ASK_CODEX_PERSIST=

# Grok advisor: wall-clock timeout in seconds (default 900).
ASK_GROK_TIMEOUT=
# Grok advisor: minimum non-whitespace stdout bytes to count as an answer (default 1).
ASK_GROK_MIN_BYTES=
# Grok advisor: login file whose expiry is checked before a call (default: ~/.grok/auth.json).
ASK_GROK_AUTH_FILE=
