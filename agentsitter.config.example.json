{
  "approver": {
    "name": "the approver",
    "identity": "approver",
    "allowed_signers": "~/.config/agentsitter/allowed_signers",
    "signing_key": "~/.config/agentsitter/approver_ed25519"
  },
  "approval": {
    "namespace": "agentsitter",
    "ttl_seconds": 900
  },
  "budget": {
    "per_decision": 2,
    "per_window": 6
  },
  "advisors": {
    "gemini": {
      "model": "gemini-REPLACE-WITH-YOUR-MODEL"
    }
  },
  "seats": {
    "claude": {
      "architecture": {
        "advisor": "gemini",
        "model": "gemini-REPLACE-WITH-YOUR-ARCHITECTURE-MODEL",
        "timeout": 480
      }
    }
  },
  "rules": {
    "extra": [
      {
        "id": "make-release",
        "lane": 3,
        "category": "deploy",
        "pattern": "\\bmake\\s+release\\b"
      }
    ],
    "disable": []
  }
}
